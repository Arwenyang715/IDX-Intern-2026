# %% [markdown]
# 3. Define IQR Outlier Detection Function

# %%
def add_iqr_flags(df, numeric_cols):
    df = df.copy()
    iqr_summary = []

    for col in numeric_cols:
        if col in df.columns:
            Q1 = df[col].quantile(0.25)
            Q3 = df[col].quantile(0.75)
            IQR = Q3 - Q1

            lower_bound = Q1 - 1.5 * IQR
            upper_bound = Q3 + 1.5 * IQR

            flag_col = col + "_outlier_flag"
            df[flag_col] = ((df[col] < lower_bound) | (df[col] > upper_bound)).astype(int)

            iqr_summary.append({
                "column": col,
                "Q1": Q1,
                "Q3": Q3,
                "IQR": IQR,
                "lower_bound": lower_bound,
                "upper_bound": upper_bound,
                "outlier_count": df[flag_col].sum(),
                "outlier_percentage": df[flag_col].mean() * 100
            })

    iqr_summary = pd.DataFrame(iqr_summary)

    return df, iqr_summary

# %% [markdown]
# ## 4. Apply IQR Flags
# 
# the IQR boundaries and the number of outliers detected for each numeric field

# %%
sold_flagged, sold_iqr_summary = add_iqr_flags(sold, numeric_cols)
listed_flagged, listed_iqr_summary = add_iqr_flags(listed, numeric_cols)

print("Sold IQR Summary:")
display(sold_iqr_summary)

print("Listed IQR Summary:")
display(listed_iqr_summary)

# %% [markdown]
# ## 5. Add Business Rule Flags

# %%
def add_business_rule_flags(df):
    df = df.copy()

    df["invalid_ClosePrice_flag"] = (df["ClosePrice"] <= 0).astype(int)
    df["invalid_LivingArea_flag"] = (df["LivingArea"] <= 0).astype(int)
    df["invalid_DaysOnMarket_flag"] = (df["DaysOnMarket"] < 0).astype(int)

    return df

